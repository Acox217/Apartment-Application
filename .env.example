# REQUIRED: Gmail sender account (enable 2-Step Verification and create an App Password)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_app_password_16_chars

# Who receives applications at your company/leasing office:
TO_EMAIL=leasing@yourcompany.com

# Frontend origin for CORS during local dev (the HTML file you open runs on file://, we’ll also allow localhost)
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000,http://127.0.0.1:3000
